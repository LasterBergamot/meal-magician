# Supabase — public values (safe to expose in the browser; Row-Level Security protects data)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server-only (NEVER expose to the browser / never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — used only inside the Supabase Edge Function during the AI phase (Phase 7)
# ANTHROPIC_API_KEY=your-anthropic-key
