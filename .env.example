# Copy to .env (git-ignored) and fill in. `task serve` and `task serve:pg` load it.
# Never commit real values, never paste them into issues or chat. See documentation/Auth-Setup.md.

# Google OAuth client (the "meal-magician" client; the same one Cloud Run uses, PLAN.md D23).
# Without these, the app still starts but signing in fails at Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own Google e-mail address; comma-separate several. These people may always sign in and
# manage the allowlist. Matching ignores upper/lower case.
MM_ADMIN_EMAILS=you@gmail.com
