# Copy to .env (git-ignored) and fill in. `task serve` and `task serve:pg` load it.
# Never commit real values, never paste them into issues or chat. See documentation/Auth-Setup.md.

# Google OAuth client (the "meal-magician" client; the same one Cloud Run uses, PLAN.md D23).
# Without these, the app still starts but signing in fails at Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Your own Google e-mail address; comma-separate several. These people may always sign in and
# manage the allowlist. Matching ignores upper/lower case.
MM_ADMIN_EMAILS=you@gmail.com

# The AI assistant (#157). Off by default: leave all of this out and nothing calls Google. To try it
# locally: `gcloud auth application-default login` once (no key is ever stored), then fill these in.
# Use `task serve` as usual. See documentation/Hosting-Setup.md part 9 for the values and the sources.
# MM_AI_ENABLED=true
# AI_PROJECT_ID=your-gcp-project-id
# AI_LOCATION=eu
# AI_CHAT_MODEL=gemini-3.5-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001
# AI_EMBEDDING_LOCATION=europe-west3
# USD per million tokens of the chat model above (Vertex AI pricing page).
# AI_PRICE_IN=1.65
# AI_PRICE_OUT=9.90
