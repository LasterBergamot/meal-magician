{
  "interactiveLogin": false,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "default",
      "tokenExpiry": 300,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "e2e-user",
            "email": "e2e@example.test",
            "email_verified": true,
            "name": "E2E User"
          }
        }
      ]
    }
  ]
}
