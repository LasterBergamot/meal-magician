# Keep the build context small and the image build reproducible: only what Gradle needs to build
# the boot jar goes into the build stage (container.md).
.git
.github
.claude
.idea
.vscode
.gradle
.tools
build
documentation
*.md
.env*
compose*.yml
Dockerfile
.dockerignore
# Tests are not part of the image; the e2e tests run against it from outside.
src/test
src/e2eTest
# Generated by Tailwind inside the build stage; a stale local copy must not leak in.
src/main/resources/static/css/app.css
