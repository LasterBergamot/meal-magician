<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Checkstyle only guards Javadoc (CLAUDE.md: "Javadoc is documentation too"). Formatting is
  Spotless' job (google-java-format), so no style checks here. Checkstyle can tell whether a
  comment exists; whether it explains the *why* is up to the author and the reviewer.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="charset" value="UTF-8"/>

  <module name="TreeWalker">
    <!-- Every public class, record, interface and enum needs a Javadoc. -->
    <module name="MissingJavadocType">
      <property name="scope" value="public"/>
    </module>
    <!-- Every public method needs one; getters/setters are not exempt because Lombok generates them. -->
    <module name="MissingJavadocMethod">
      <property name="scope" value="public"/>
      <property name="allowMissingPropertyJavadoc" value="false"/>
      <property name="ignoreMethodNamesRegex" value="^main$"/>
    </module>
    <!-- Record components are documented with @param on the record's Javadoc. -->
    <module name="JavadocType">
      <property name="scope" value="public"/>
    </module>
    <module name="JavadocMethod">
      <property name="accessModifiers" value="public"/>
      <property name="allowMissingParamTags" value="true"/>
      <property name="allowMissingReturnTag" value="true"/>
    </module>
    <!-- The first sentence is what IDEs and the generated docs show; it must be a real sentence. -->
    <module name="SummaryJavadoc"/>
    <module name="NonEmptyAtclauseDescription"/>
    <module name="InvalidJavadocPosition"/>
  </module>

  <!-- Every package (module) needs a package-info.java explaining what it is for. -->
  <module name="JavadocPackage"/>
</module>
